# Database Connection
# Default SQLite database for instant zero-configuration local runs on Windows:
DATABASE_URL="file:./dev.db"

# For PostgreSQL deployment, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/dependency_prioritizer?schema=public"

# Application Settings
NODE_ENV="development"
PORT=3000
MAX_UPLOAD_SIZE_MB=15
MAX_RECORDS_PER_SCAN=5000
